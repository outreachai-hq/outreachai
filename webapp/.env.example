# ── Database (get a free one at neon.tech) ────────────────────────────────────
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Auth ─────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=change-me-to-any-random-32-char-string
NEXTAUTH_URL=https://your-app.vercel.app

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
ENCRYPTION_KEY=change-me-to-any-random-32-char-string

# ── Email — Resend (free tier: 3,000/month at resend.com) ────────────────────
# Used for transactional email (password reset). User campaign emails use their own SMTP.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Google OAuth (get from console.cloud.google.com) ─────────────────────────
# Authorized redirect URI to add: https://your-app.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── MCP Server (OutreachAI agent API at POST /api/mcp) ────────────────────────
# Set this to any strong random string. Pass as: Authorization: Bearer <token>
MCP_AUTH_TOKEN=change-me-to-any-random-string

# ── LinkedIn OAuth (for auto-posting scheduler) ────────────────────────────────
# Create app at linkedin.com/developers — add "Share on LinkedIn" product
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Stripe (disabled during beta) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_disabled
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_disabled
STRIPE_PRO_PRICE_ID=price_disabled

# ── Queue (Redis + BullMQ) ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── AWS SES Event Queue ───────────────────────────────────────────────────────
SES_EVENT_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<AWS_ACCOUNT_ID>/outreachai-ses-events
AWS_REGION=ap-south-1


# Comma-separated emails allowed into /admin/users (registered-users dashboard)
ADMIN_EMAILS=you@example.com

# ── Testing (never commit real values) ────────────────────────────────────────
# Used by Playwright (npm run test:critical / test:all-flows) and scripts/seed-test-user.ts
TEST_USER_EMAIL=e2e@example.com
TEST_USER_PASSWORD=
ADMIN_SECRET=
# Optional: real inbox to receive SES test sends (defaults to the SES simulator)
TEST_RECIPIENT_EMAIL=
# Optional: SMTP account for scripts/seed-test-email-account.ts
TEST_SMTP_USER=
TEST_SMTP_PASS=
