{
  "name": "webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:prod": "npm run db:migrate:prod && prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "deploy": "npm run build && vercel --prod",
    "deploy:preview": "npm run build && vercel",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:ui": "playwright test --config playwright.config.ts --ui",
    "test:e2e:headed": "playwright test --config playwright.config.ts --headed",
    "test:all": "npm run test && npm run test:e2e",
    "test:critical": "playwright test --config playwright.config.ts tests/e2e/critical-path.spec.ts",
    "test:critical:prod": "PLAYWRIGHT_BASE_URL=https://outreachai.in playwright test --config playwright.config.ts tests/e2e/critical-path.spec.ts",
    "test:critical:show-report": "playwright show-report playwright-report",
    "test:all-flows": "playwright test --config playwright.config.ts tests/e2e/all-flows.spec.ts",
    "test:all-flows:prod": "PLAYWRIGHT_BASE_URL=https://outreachai.in playwright test --config playwright.config.ts tests/e2e/all-flows.spec.ts",
    "db:migrate:prod": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/migrate-prod.ts"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@auth/prisma-adapter": "^2.11.2",
    "@aws-sdk/client-ses": "^3.1075.0",
    "@aws-sdk/client-sqs": "^3.1086.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.0.0",
    "@sendgrid/mail": "^8.1.6",
    "@stripe/stripe-js": "^9.8.0",
    "@tiptap/extension-character-count": "^3.27.4",
    "@tiptap/extension-link": "^3.27.4",
    "@tiptap/extension-placeholder": "^3.27.4",
    "@tiptap/pm": "^3.27.4",
    "@tiptap/react": "^3.27.4",
    "@tiptap/starter-kit": "^3.27.4",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.80.2",
    "imapflow": "^1.4.2",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.21.0",
    "next": "^15.5.19",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "openai": "^6.44.0",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.14.0",
    "stripe": "^22.2.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "vitest-fetch-mock": "^0.4.5"
  }
}
