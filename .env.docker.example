# REQUIRED — generate with: openssl rand -hex 32
NEXTAUTH_SECRET=your-secret-here
ENCRYPTION_KEY=your-32-char-key-here

# REQUIRED — your public URL (use http://localhost:3000 for local)
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# REQUIRED — strong password for the local PostgreSQL container
POSTGRES_PASSWORD=changeme_to_something_strong

# OPTIONAL — Google OAuth (for social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn OAuth (for auto-posting scheduler)
# Create app at linkedin.com/developers — add "Share on LinkedIn" product
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
CRON_SECRET=    # generate: openssl rand -hex 16

# OPTIONAL — Transactional email (password reset, invites)
# Sign up free at resend.com — 3,000 emails/month free
RESEND_API_KEY=

# OPTIONAL — AI features (users can also add their own keys in Settings)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
